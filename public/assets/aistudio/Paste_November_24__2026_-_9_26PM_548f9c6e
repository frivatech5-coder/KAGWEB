                <p className="text-sm text-ink/60 truncate">{t.artist || 'KAG Emmanuel Witima'} · {mb(t.size)}</p>
              </div>
              <a href={t.url} className="btn btn-line text-pine !min-h-11 !px-4 !py-2 text-sm" aria-label={'Download ' + t.title}>
                <Download size={16} /> <span className="hidden sm:inline">Download</span>
              </a>
              {user && fb && (
                <button aria-label="Delete song" className="p-2 text-red-700 hover:bg-red-100 rounded-full"
                  onClick={() => confirm(`Delete "${t.title}"?`) && fb.deleteTrack(t)}><Trash2 size={18} /></button>
              )}
            </li>
          ))}
        </ul>

        <div className="mt-8 text-sm">
          {!showAdmin && !user && <button onClick={() => setShowAdmin(true)} className="text-ink/45 hover:text-ink underline underline-offset-4">Music admin</button>}
          {(showAdmin || user) && fb && <AdminUpload fb={fb} user={user} />}
        </div>
      </div>
    </section>
  );
};

const AdminUpload: React.FC<{ fb: FB; user: { email: string | null } | null }> = ({ fb, user }) => {
  const [title, setTitle] = useState('');
  const [artist, setArtist] = useState('');
  const [file, setFile] = useState<File | null>(null);
  const [pct, setPct] = useState<number | null>(null);
  const [msg, setMsg] = useState('');

  if (!user)
    return (
      <div className="bg-paper rounded-2xl p-5 max-w-md">
        <p className="mb-3">Sign in with the church admin Google account to upload songs.</p>
        <button className="btn btn-clay" onClick={() => fb.adminSignIn().catch(() => setMsg('Sign-in cancelled.'))}>Sign in with Google</button>
        {msg && <p className="mt-2 text-red-700">{msg}</p>}
      </div>
    );

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!file || !title.trim()) return;
    setMsg(''); setPct(0);
    try {
      await fb.uploadTrack(file, { title: title.trim(), artist: artist.trim() }, setPct);
      setMsg('Uploaded! It is now live on the website.');
      setTitle(''); setArtist(''); setFile(null);
    } catch {
      setMsg('Upload failed. Make sure you are signed in with the admin account and the file is audio under 40 MB.');
    }
    setPct(null);
  };

  return (
    <form onSubmit={submit} className="bg-paper rounded-2xl p-5 max-w-lg space-y-3 border border-gold/40">
      <div className="flex items-center justify-between">
        <h3 className="font-bold text-lg text-pine">Upload a new song</h3>
        <button type="button" onClick={() => fb.adminSignOut()} className="flex items-center gap-1 text-ink/60 hover:text-ink"><LogOut size={14} /> Sign out</button>
      </div>
      <input required value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Song title" className="w-full rounded-xl border border-ink/20 bg-white px-4 py-3" />
      <input value={artist} onChange={(e) => setArtist(e.target.value)} placeholder="Singer / choir (optional)" className="w-full rounded-xl border border-ink/20 bg-white px-4 py-3" />
      <input required type="file" accept="audio/*" onChange={(e) => setFile(e.target.files?.[0] ?? null)} className="w-full text-sm file:mr-3 file:rounded-full file:border-0 file:bg-pine file:text-white file:px-4 file:py-2" />
      {pct !== null && <div className="h-2 rounded bg-sand"><div className="h-2 rounded bg-clay transition-all" style={{ width: pct + '%' }} /></div>}
      <button disabled={pct !== null} className="btn btn-clay disabled:opacity-50"><Upload size={16} /> {pct !== null ? `Uploading ${pct}%` : 'Upload song'}</button>
      {msg && <p className="text-sm">{msg}</p>}
    </form>
  );
};
