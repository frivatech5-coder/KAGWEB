// ---------- Music library ----------
export interface MusicTrack {
  id: string;
  title: string;
  artist: string;
  url: string;
  storagePath: string;
  size: number;
  createdAt: string;
}

const storage = getStorage(app);

export function subscribeToMusic(onUpdate: (tracks: MusicTrack[]) => void, onError?: (e: Error) => void) {
  const q = query(collection(db, 'music'), orderBy('createdAt', 'desc'));
  return onSnapshot(
    q,
    (snap) => onUpdate(snap.docs.map((d) => ({ id: d.id, ...(d.data() as Omit<MusicTrack, 'id'>) }))),
    (e) => onError?.(e)
  );
}

export const watchAuth = (cb: (u: User | null) => void) => onAuthStateChanged(auth, cb);
export const adminSignIn = () => signInWithPopup(auth, new GoogleAuthProvider());
export const adminSignOut = () => signOut(auth);

const friendlyError = (code: string) =>
  ({
    'storage/unauthorized': 'Permission denied. Sign in with the admin Google account and publish storage.rules.',
    'storage/unauthenticated': 'You are not signed in. Sign in with Google and try again.',
    'storage/bucket-not-found': 'Firebase Storage is not set up for this project yet. Use "Paste a link" instead, or enable Storage in the Firebase console.',
    'storage/project-not-found': 'Firebase Storage is not set up for this project yet. Use "Paste a link" instead, or enable Storage in the Firebase console.',
    'storage/retry-limit-exceeded': 'Upload timed out. Storage may not be enabled (it can require the Blaze plan). Use "Paste a link" instead.',
    'storage/canceled': 'Upload stopped.',
    stalled: 'The upload never started. Firebase Storage is probably not enabled or not allowed for this project (new projects may need the Blaze plan). Use "Paste a link" instead.',
  } as Record<string, string>)[code] || `Upload failed (${code}).`;

export async function uploadTrack(
  file: File,
  meta: { title: string; artist: string },
  onProgress: (pct: number) => void
): Promise<void> {
  storage.maxUploadRetryTime = 20000; // fail fast instead of hanging at 0%
  storage.maxOperationRetryTime = 20000;
  const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
  const storagePath = `music/${Date.now()}_${safe}`;
  const task = uploadBytesResumable(ref(storage, storagePath), file, {
    contentType: file.type || 'audio/mpeg',
    // makes the Download button save the file instead of just opening it
    contentDisposition: `attachment; filename="${safe}"`,
  });
  await new Promise<void>((resolve, reject) => {
    let started = false;
    const watchdog = setTimeout(() => { if (!started) { task.cancel(); reject({ code: 'stalled' }); } }, 15000);
    task.on(
      'state_changed',
      (s) => { if (s.bytesTransferred > 0) started = true; onProgress(Math.round((s.bytesTransferred / s.totalBytes) * 100)); },
      (e) => { clearTimeout(watchdog); reject(e); },
      () => { clearTimeout(watchdog); resolve(); }
    );
  }).catch((e) => { throw new Error(friendlyError(e?.code || 'unknown')); });
  const url = await getDownloadURL(task.snapshot.ref);
  await addDoc(collection(db, 'music'), { ...meta, url, storagePath, size: file.size, createdAt: new Date().toISOString() });
}

/** Works without Firebase Storage: paste a direct audio link or a Google Drive share link. */
export function normaliseAudioLink(raw: string): string | null {
  const u = raw.trim();
  if (!/^https:\/\//i.test(u)) return null;
  const drive = u.match(/drive\.google\.com\/(?:file\/d\/|open\?id=|uc\?(?:export=\w+&)?id=)([\w-]{20,})/);
  return drive ? `https://drive.google.com/uc?export=download&id=${drive[1]}` : u;
}
export async function addTrackByLink(meta: { title: string; artist: string }, link: string): Promise<void> {
  const url = normaliseAudioLink(link);
  if (!url) throw new Error('Please paste a full link starting with https://');
  await addDoc(collection(db, 'music'), { ...meta, url, storagePath: '', size: 0, createdAt: new Date().toISOString() });
}

export async function deleteTrack(t: MusicTrack): Promise<void> {
  if (t.storagePath) await deleteObject(ref(storage, t.storagePath)).catch(() => {});
  await deleteDoc(doc(db, 'music', t.id));
}
